<!doctype html>
<html lang="en">
<head>
<%- include('../template/head', { title: 'Edit product' }) %>
</head>

<body>
<div class="app">
<%- include('../template/nav', { active: 'inventory' }) %>
<main class="content">
<%- include('../template/topbar') %>
<%- include('../template/messages') %>
<header class="page-header">
<h1>Edit product #<%= product.Product_ID %></h1>
</header>
<section class="panel form-panel">

<form action="/products/<%= product.Product_ID %>/edit" method="POST"
data-confirm="Save changes to <%= product.Name %>?"
data-confirm-button="Save changes">
<div class="mb-3">
<label for="Name" class="form-label">Name</label>
<input type="text" class="form-control" id="Name" name="Name"
value="<%= product.Name %>" maxlength="100" required>
</div>

<div class="mb-3">
<label for="Category_ID" class="form-label">Category</label>
<select class="form-select" id="Category_ID" name="Category_ID" required>
<% categories.forEach(function(c) { %>
<option value="<%= c.Category_ID %>" <%= c.Category_ID == product.Category_ID ? 'selected' : '' %>><%= c.Category %></option>
<% }); %>
</select>
</div>

<div class="mb-3">
<label for="Supplier_ID" class="form-label">Supplier</label>
<select class="form-select" id="Supplier_ID" name="Supplier_ID" required>
<% suppliers.forEach(function(s) { %>
<option value="<%= s.Supplier_ID %>" <%= s.Supplier_ID == product.Supplier_ID ? 'selected' : '' %>><%= s.Name %></option>
<% }); %>
</select>
</div>

<div class="mb-3">
<label for="Availability" class="form-label">Availability</label>
<select class="form-select" id="Availability" name="Availability">
<option value="1" <%= product.Availability ? 'selected' : '' %>>Available</option>
<option value="0" <%= !product.Availability ? 'selected' : '' %>>Not available</option>
</select>
</div>

<button type="submit" class="btn btn-primary">Save changes</button>

<% if (Role === 'Manager') { %>
  <a href="/products/<%= product.Product_ID %>/variants/new"
     class="btn btn-outline-primary">
    + Add Size / Color
  </a>
<% } %>

<a href="/inventory#p<%= product.Product_ID %>" class="btn btn-outline-secondary">Cancel</a>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
</form>

<% if (user && String(user.role || '').toLowerCase() === 'manager') { %>
<hr class="my-4">
<h2 class="h5">Delete product</h2>
<p class="text-muted">This permanently removes the product from the catalog. Products with linked variants cannot be deleted; those dependencies must be resolved first.</p>
<form action="/products/<%= product.Product_ID %>/delete" method="POST"
      data-confirm="Permanently delete <%= product.Name %>? This cannot be undone."
      data-confirm-button="Delete product"
      data-confirm-style="danger">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <button type="submit" class="btn btn-outline-danger">Delete Product</button>
</form>
<% } %>
</section>
<%- include('../template/footer') %>
</main>
</div>
<%- include('../template/scripts') %>
<%- include('../template/confirm') %>
</body>
</html>