<!doctype html>
<html lang="en">
<head>
<%- include('../template/head', { title: 'Edit location' }) %>
</head>

<body>
<div class="app">
<%- include('../template/nav', { active: 'manage' }) %>
<main class="content">
<%- include('../template/topbar') %>
<%- include('../template/messages') %>
<header class="page-header">
<h1>Edit location #<%= location.Location_ID %></h1>
</header>
<section class="panel form-panel">

<form action="/locations/<%= location.Location_ID %>/edit" method="POST"
data-confirm="Save changes to <%= location.Location_Name %>?"
data-confirm-button="Save changes">
<div class="mb-3">
<label for="Location_Name" class="form-label">Location name</label>
<input type="text" class="form-control" id="Location_Name" name="Location_Name"
value="<%= location.Location_Name %>" required>
</div>

<button type="submit" class="btn btn-primary">Save changes</button>
<a href="/" class="btn btn-outline-secondary">Cancel</a>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
</form>

<hr class="my-4">
<form action="/locations/<%= location.Location_ID %>/delete" method="POST"
data-confirm="Delete <%= location.Location_Name %>? This can't be undone."
data-confirm-button="Delete">
<button type="submit" class="btn btn-outline-danger">Delete location</button>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
</form>
</section>
<%- include('../template/footer') %>
</main>
</div>
<%- include('../template/scripts') %>
<%- include('../template/confirm') %>
</body>
</html>