<!doctype html>
<html lang="en">
    <head>
        <%- include('../template/head', { title: 'Log in' }); %>
    </head>

    <body class="auth-body">
        <main class="auth-card">
            <img class="auth-logo" src="/images/logo.png" alt="SCC logo">
            <h1>Employee login</h1>
            <% if (ErrorMessage) { %>
              <p class="form-error" role="alert"><%= ErrorMessage %></p>
            <% } %>
            <!-- The form posts to /process/login. The input names (Username, Password) must stay the same for the login to work. -->
            <form action="/process/login" method="POST" class="auth-form">
              <label for="Username">Username</label>
              <input type="text" id="Username" name="Username" autocomplete="username" required autofocus>

              <label for="Password">Password</label>
              <input type="password" id="Password" name="Password" autocomplete="current-password" required>

              <button type="submit" class="scc-btn">Log in</button>
            </form>
            <p class="auth-brand"><a href="/">Back to dashboard</a></p>
        </main>
        <%- include('../template/scripts'); %>
    </body>
</html>
