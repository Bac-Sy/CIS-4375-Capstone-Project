<%
  const dashboardData = (typeof data !== 'undefined' && data && typeof data === 'object')
    ? data : {};
  const dashboardUser = (typeof user !== 'undefined' && user && typeof user === 'object')
    ? user : {};

  const salesAvailable = Boolean(dashboardData.sales && typeof dashboardData.sales === 'object');
  const salesInput = salesAvailable ? dashboardData.sales : {};
  const sales = {
    revenue: salesInput.revenue === null || salesInput.revenue === undefined
      ? null : (Number(salesInput.revenue) || 0),
    units: salesInput.units === null || salesInput.units === undefined
      ? null : (Number(salesInput.units) || 0),
    days: Number(salesInput.days) > 0 ? Number(salesInput.days) : 30
  };

  // Recent orders: one type at a time (Sales by default) so stock corrections don't hide real orders.
  const recentKind = (typeof recentType !== 'undefined' && recentType) ? recentType : 'Sale';
  const recentByType = dashboardData.recent_by_type && typeof dashboardData.recent_by_type === 'object' ? dashboardData.recent_by_type : null;
  const recentSource = recentByType ? recentByType[recentKind] : dashboardData.recent_orders;
  const ordersAvailable = Array.isArray(recentSource);
  const recentOrders = ordersAvailable
    ? recentSource.filter(o => o && typeof o === 'object') : [];
  const recentTabs = [['Sale', 'Sales'], ['Restock', 'Restocks'], ['Adjustment', 'Adjustments']];

  const stockAvailable = Array.isArray(dashboardData.low_stock);
  const lowStock = stockAvailable
    ? dashboardData.low_stock.filter(item => item && typeof item === 'object') : [];
  const onHand = dashboardData.inventory_totals && typeof dashboardData.inventory_totals === 'object' ? dashboardData.inventory_totals : null;
  // 0 is a valid threshold (only empty items are low), so only fall back to 5 when it's missing.
  const threshold = dashboardData.low_stock_threshold !== undefined && dashboardData.low_stock_threshold !== null &&
    Number.isFinite(Number(dashboardData.low_stock_threshold)) && Number(dashboardData.low_stock_threshold) >= 0
    ? Number(dashboardData.low_stock_threshold) : 5;

  // Support either values passed separately by Express or values under data.
  const donutSource = (typeof donut !== 'undefined' && donut && typeof donut === 'object')
    ? donut : (dashboardData.donut || dashboardData.sales_donut || salesInput.donut || {});
  const segments = Array.isArray(donutSource.segments) ? donutSource.segments : [];
  const hasDonut = segments.length > 0;

  // Stock in vs. out: units sold and restocked per week (built by frontend/lib/charts.js buildFlow).
  const flowChart = (typeof flow !== 'undefined' && flow && typeof flow === 'object') ? flow : null;

  // server.js does not currently supply fmt; use safe built-in formatters.
  const providedFmt = (typeof fmt !== 'undefined' && fmt && typeof fmt === 'object')
    ? fmt : {};
  const displayFmt = {
    money(value) {
      if (typeof providedFmt.money === 'function') return providedFmt.money(value);
      const n = Number(value);
      return Number.isFinite(n)
        ? n.toLocaleString('en-US', { style: 'currency', currency: 'USD' }) : 'N/A';
    },
    number(value) {
      if (typeof providedFmt.number === 'function') return providedFmt.number(value);
      const n = Number(value);
      return Number.isFinite(n) ? n.toLocaleString('en-US') : 'N/A';
    },
    date(value) {
      if (typeof providedFmt.date === 'function') return providedFmt.date(value);
      if (!value) return 'N/A';
      const d = new Date(value);
      return Number.isNaN(d.getTime()) ? 'N/A' : d.toLocaleDateString('en-US');
    },
    signed(value) {
      if (typeof providedFmt.signed === 'function') return providedFmt.signed(value);
      const n = Number(value);
      return Number.isFinite(n) ? `${n > 0 ? '+' : ''}${n.toLocaleString('en-US')}` : 'N/A';
    },
    tagClass(value) {
      return typeof providedFmt.tagClass === 'function' ? providedFmt.tagClass(value) : '';
    }
  };

  // server.js stores the logged in employee's first name as FirstName
  const welcomeName = (typeof FirstName !== 'undefined' && FirstName) || dashboardUser.firstName || dashboardUser.name || '';
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../template/head', { title: 'Dashboard' }) %>
</head>
<body>
  <div class="app">
    <%- include('../template/nav', { active: 'dashboard' }) %>

    <main class="content">
      <%- include('../template/topbar') %>
      <%- include('../template/messages') %>

      <header class="page-header">
        <h1><%= welcomeName ? 'Welcome, ' + welcomeName : 'Welcome' %></h1>
      </header>

      <section class="dashboard-grid" aria-label="Dashboard overview">
        <!-- SALES -->
        <article class="dash-card">
          <h2>Sales</h2>
          <div class="dash-body sales">
            <% if (!salesAvailable) { %>
              <p class="empty">Sales data is not connected yet.</p>
            <% } else { %>
              <% if (hasDonut) { %>
                <svg class="donut" viewBox="0 0 42 42" role="img"
                     aria-label="Sales by category for the last <%= sales.days %> days">
                  <circle cx="21" cy="21" r="15.9155" fill="none"
                          stroke="#e4e7ff" stroke-width="7" />
                  <% segments.forEach(function(seg) { %>
                    <circle cx="21" cy="21" r="15.9155" fill="none"
                            stroke="<%= seg.color || '#5154bc' %>"
                            stroke-width="7"
                            stroke-dasharray="<%= seg.dash || '0 100' %>"
                            stroke-dashoffset="<%= seg.offset || 0 %>" />
                  <% }); %>
                </svg>
              <% } %>
              <div class="sales-summary">
                <p class="sales-total"><%= sales.revenue === null ? 'Revenue unavailable' : displayFmt.money(sales.revenue) %></p>
                <p class="sales-note">
                  <%= sales.units === null ? 'Units unavailable' : displayFmt.number(sales.units) + (sales.units === 1 ? ' unit sold' : ' units sold') %> in the last
                  <%= sales.days %> days
                </p>
                <% if (hasDonut) { %>
                  <ul class="legend">
                    <% segments.forEach(function(seg) { %>
                      <li>
                        <span class="dot" style="background-color: <%= seg.color || '#5154bc' %>"></span>
                        <span class="legend-name"><%= seg.name || 'Other' %></span>
                        <span class="legend-value"><%= displayFmt.money(seg.revenue || 0) %></span>
                      </li>
                    <% }); %>
                  </ul>
                <% } %>
              </div>
            <% } %>
          </div>
        </article>

        <!-- RECENT ORDERS -->
        <article class="dash-card">
          <div class="dash-head">
            <h2>Recent orders</h2>
            <nav class="card-tabs" aria-label="Show recent orders by type">
              <% recentTabs.forEach(function(tab) { %>
                <a href="/?recent=<%= tab[0] %>" class="<%= recentKind === tab[0] ? 'active' : '' %>"<% if (recentKind === tab[0]) { %> aria-current="page"<% } %>><%= tab[1] %></a>
              <% }); %>
            </nav>
          </div>
          <div class="dash-body">
            <% if (!ordersAvailable) { %>
              <p class="empty">Recent order data is not connected yet.</p>
            <% } else if (recentOrders.length === 0) { %>
              <p class="empty">No <%= recentKind === 'Sale' ? 'sales' : recentKind === 'Restock' ? 'restocks' : 'adjustments' %> recorded yet.</p>
            <% } else { %>
              <ul class="rows">
                <% recentOrders.forEach(function(o) { %>
                  <% const orderQty = Number(o.quantity_change) || 0; %>
                  <li>
                    <div class="row-main">
                      <span class="row-title"><%= o.product || 'Unknown Product' %></span>
                      <span class="row-sub">
                        <%= o.size || 'N/A' %> / <%= o.color || 'N/A' %> ·
                        <%= displayFmt.date(o.date) %> ·
                        <%= o.employee || 'Unknown' %><% if (o.transaction_type === 'Restock' && o.supplier) { %> · from <%= o.supplier %><% } %>
                      </span>
                    </div>
                    <span class="qty <%= orderQty < 0 ? 'neg' : 'pos' %>"><%= displayFmt.signed(orderQty) %></span>
                  </li>
                <% }); %>
              </ul>
            <% } %>
          </div>
          <a class="dash-link" href="/orders<%= recentKind ? '?type=' + recentKind : '' %>">View all <%= recentKind === 'Sale' ? 'sales' : recentKind === 'Restock' ? 'restocks' : 'adjustments' %> →</a>
        </article>
        <!-- CURRENT INVENTORY AND LOW STOCK -->
        <article class="dash-card">
          <h2>Inventory</h2>
          <% if (onHand) { %>
            <div class="on-hand">
              <p class="sales-total"><%= displayFmt.number(onHand.units) %> <%= onHand.units === 1 ? 'unit' : 'units' %> in stock</p>
              <p class="sales-note">across <%= displayFmt.number(onHand.items) %> <%= onHand.items === 1 ? 'item' : 'items' %> (size / color) of <%= displayFmt.number(onHand.products) %> <%= onHand.products === 1 ? 'product' : 'products' %></p>
            </div>
          <% } %>
          <h3 class="dash-sub">Low stock <span class="muted">(<%= threshold %> or fewer)</span></h3>
          <div class="dash-body">
            <% if (!stockAvailable) { %>
              <p class="empty">Inventory data is not connected yet.</p>
            <% } else if (lowStock.length === 0) { %>
              <p class="empty">
                Nothing is running low. Items with <%= threshold %> or fewer units appear here.
              </p>
            <% } else { %>
              <ul class="rows">
                <% lowStock.forEach(function(item) { %>
                  <%
                    const quantity = Number(item.quantity) || 0;
                    const pct = Math.min(100, Math.max(0, Math.round((quantity / threshold) * 100)));
                  %>
                  <li class="stock-row">
                    <div class="row-main">
                      <span class="row-title"><%= item.product || 'Unknown Product' %></span>
                      <span class="row-sub">
                        <%= item.size || 'N/A' %> / <%= item.color || 'N/A' %>
                      </span>
                    </div>
                    <span class="meter" role="img" aria-label="<%= quantity %> in stock">
                      <i style="width: <%= pct %>%;"></i>
                    </span>
                    <span class="tag tag-red"><%= quantity === 0 ? 'Out of stock' : quantity + ' left' %></span>
                  </li>
                <% }); %>
              </ul>
            <% } %>
          </div>
          <a class="dash-link" href="/inventory?low=1">View low stock in Inventory →</a>
        </article>

        <!-- STOCK IN VS. OUT -->
        <article class="dash-card">
          <div class="dash-head">
            <h2>Stock in vs. out</h2>
            <span class="muted" style="font-size:.85rem">Units per week · last 4 weeks</span>
          </div>
          <div class="dash-body">
            <% if (flowChart) { %>
              <% const net = flowChart.totals.restocked - flowChart.totals.sold; %>
              <div class="flow">
                <p class="flow-summary">
                  Sold <strong><%= displayFmt.number(flowChart.totals.sold) %></strong>,
                  restocked <strong><%= displayFmt.number(flowChart.totals.restocked) %></strong>:
                  <% if (net === 0) { %>stock is <strong>unchanged</strong>.<% } else { %>stock is <strong class="<%= net < 0 ? 'neg' : 'pos' %>"><%= net < 0 ? 'down' : 'up' %> <%= displayFmt.number(Math.abs(net)) %> <%= Math.abs(net) === 1 ? 'unit' : 'units' %></strong>.<% } %>
                </p>
                <div class="flow-legend">
                  <span><i style="background:<%= flowChart.colors.sold %>"></i>Sold</span>
                  <span><i style="background:<%= flowChart.colors.restocked %>"></i>Restocked</span>
                </div>
                <svg class="flow-chart" viewBox="0 0 <%= flowChart.width %> <%= flowChart.height %>" role="img"
                     aria-label="Units sold and restocked per week for the last 4 weeks. Sold <%= flowChart.totals.sold %>, restocked <%= flowChart.totals.restocked %>.">
                  <% flowChart.gridlines.forEach(function(g) { %>
                    <line x1="<%= flowChart.left %>" y1="<%= g.y %>" x2="<%= flowChart.width %>" y2="<%= g.y %>" stroke="<%= g.value === 0 ? '#c9cdfb' : '#eef0f6' %>" stroke-width="1" />
                    <text x="<%= flowChart.left - 8 %>" y="<%= Number(g.y) + 4 %>" text-anchor="end" font-size="11" fill="#5d6388"><%= Number.isInteger(g.value) ? g.value : g.value.toFixed(1) %></text>
                  <% }); %>
                  <% flowChart.bars.forEach(function(bar) { %>
                    <path class="bar" d="<%= bar.d %>" fill="<%= bar.color %>"><title>Week of <%= bar.week %>: <%= bar.value %> <%= bar.kind === 'sold' ? 'sold' : 'restocked' %></title></path>
                  <% }); %>
                  <% flowChart.labels.forEach(function(l) { %>
                    <text x="<%= l.x %>" y="<%= l.y %>" text-anchor="middle" font-size="12" fill="#5d6388">Week of <%= l.text %></text>
                  <% }); %>
                </svg>
                <p class="flow-note">Hover a bar for its exact number. Adjustments aren’t counted: they’re corrections, not stock coming in or going out.</p>
              </div>
            <% } else { %>
              <p class="empty">Sales and restock history is unavailable. Check that the Flask API is running.</p>
            <% } %>
          </div>
        </article>
      </section>

      <%- include('../template/footer', { showStatus: typeof api !== 'undefined' && typeof env !== 'undefined' }) %>
    </main>
  </div>
  <%- include('../template/scripts') %>
</body>
</html>
