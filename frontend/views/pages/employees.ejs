<!doctype html>
<html lang="en">
    <head>
        <%- include('../template/head', { title: 'Employees' }); %>
    </head>

    <body>
        <div class="app">
            <%- include('../template/nav', { active: 'employees' }); %>

            <main class="content">
                <%- include('../template/topbar'); %>
                <%- include('../template/messages'); %>

                <header class="page-header">
                  <h1>Employees</h1>
                </header>

                <section class="panel">
                  <div class="panel-bar"><%= fmt.number(employees.length) %> <%= employees.length === 1 ? 'employee' : 'employees' %></div>
                  <div class="table-scroll">
                    <table class="data-table">
                      <caption class="visually-hidden">Employees</caption>
                      <thead>
                        <tr>
                          <th scope="col">Name</th>
                          <th scope="col">Username</th>
                          <th scope="col">Email</th>
                          <th scope="col">Role</th>
                          <th scope="col">Actions</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% if (!dataAvailable) { %>
                          <tr><td colspan="5" class="empty-cell">Employee data is unavailable. Check the message above and the Flask database mapping.</td></tr>
                        <% } else if (!employees.length) { %>
                          <tr><td colspan="5" class="empty-cell">No employee records in the connected data source.</td></tr>
                        <% } %>
                        <% employees.forEach(e => { %>
                          <tr>
                            <td><strong><%= [e.first_name, e.last_name].filter(Boolean).join(' ') || e.name || e.username || 'N/A' %></strong></td>
                            <td><%= e.username %></td>
                            <td><%= e.email || 'N/A' %></td>
                            <td><span class="tag tag-soft"><%= e.role || 'N/A' %></span></td>
                            <td>
                              <% if (Role === 'Manager' && e.id != null) { %>

                                <!-- EDIT EMPLOYEE -->
                                <a href="/employees/<%= e.id %>/edit"
                                  class="btn btn-outline-primary">
                                  Edit
                                </a>

                                <!-- RESET PASSWORD -->
                                <a href="/employees/<%= e.id %>/reset-password"
                                  class="btn btn-outline-secondary">
                                  Reset Password
                                </a>

                                <!-- DELETE EMPLOYEE -->
                                <form action="/employees/<%= e.id %>/delete"
                                      method="POST"
                                      class="inline-form"
                                      data-confirm="Are you sure you want to delete this employee?"
                                      data-confirm-button="Delete"
                                      data-confirm-style="danger">

                                  <input type="hidden"
                                        name="_csrf"
                                        value="<%= csrfToken %>">

                                  <button type="submit" class="btn btn-outline-danger">
                                    Delete
                                  </button>

                                </form>

                              <% } %>
                            </td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                </section>

                <%- include('../template/footer'); %>
            </main>
        </div>
                <%- include('../template/scripts'); %>
        <%- include('../template/confirm'); %>
    </body>
</html>
