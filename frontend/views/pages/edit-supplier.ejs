<!doctype html>
<html lang="en">
<head>
<%- include('../template/head', { title: 'Edit supplier' }) %>
</head>

<body>
<div class="app">
<%- include('../template/nav', { active: 'manage' }) %>
<main class="content">
<%- include('../template/topbar') %>
<%- include('../template/messages') %>
<header class="page-header">
<h1>Edit supplier #<%= supplier.Supplier_ID %></h1>
</header>
<section class="panel form-panel">

<form action="/suppliers/<%= supplier.Supplier_ID %>/edit" method="POST"
data-confirm="Save changes to <%= supplier.Name %>?"
data-confirm-button="Save changes">
<div class="mb-3">
<label for="Name" class="form-label">Name</label>
<input type="text" class="form-control" id="Name" name="Name"
value="<%= supplier.Name %>" maxlength="100" required>
</div>

<div class="mb-3">
<label for="Email" class="form-label">Email</label>
<input type="email" class="form-control" id="Email" name="Email"
value="<%= supplier.Email %>" maxlength="100">
</div>

<div class="mb-3">
<label for="Phone" class="form-label">Phone</label>
<input type="tel" class="form-control" id="Phone" name="Phone"
value="<%= supplier.Phone %>" maxlength="20">
</div>

<button type="submit" class="btn btn-primary">Save changes</button>
<a href="/" class="btn btn-outline-secondary">Cancel</a>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
</form>

<hr class="my-4">
<form action="/suppliers/<%= supplier.Supplier_ID %>/delete" method="POST"
data-confirm="Delete <%= supplier.Name %>? This can't be undone."
data-confirm-button="Delete">
<button type="submit" class="btn btn-outline-danger">Delete supplier</button>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
</form>
</section>
<%- include('../template/footer') %>
</main>
</div>
<%- include('../template/scripts') %>
<%- include('../template/confirm') %>
</body>
</html>