<!doctype html>
<html lang="en">
<head><%- include('../template/head', { title: 'Manage Catalogue' }) %></head>
<body>
<div class="app">
  <%- include('../template/nav', { active: 'manage' }) %>
  <main class="content">
    <%- include('../template/topbar') %>
    <%- include('../template/messages') %>
    <header class="page-header" style="display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;">
      <h1>Manage Catalogue</h1>
      <a href="/new/product" class="scc-btn" style="margin-top:0;">+ Add Product</a>
    </header>
    <p class="empty" style="margin-bottom:1rem">Choose a record to open its edit screen, or use the forms to add a new supplier, category, location, color or size.</p>
    <% const groups = [
      { label:'Products', items:products, key:'Product_ID', text:'Name', path:'products' },
      { label:'Product variants', items:variants, key:'Variant_ID', text:'Variant_ID', path:'variants' },
      { label:'Suppliers', items:suppliers, key:'Supplier_ID', text:'Name', path:'suppliers', single:'supplier',
        add:[{ name:'Name', label:'Name', required:true }, { name:'Email', label:'Email', type:'email' }, { name:'Phone', label:'Phone', type:'tel' }] },
      { label:'Categories', items:categories, key:'Category_ID', text:'Category', path:'categories', single:'category',
        add:[{ name:'Category', label:'Category name', required:true }] },
      { label:'Locations', items:locations, key:'Location_ID', text:'Location_Name', path:'locations', single:'location',
        add:[{ name:'Location_Name', label:'Location name', required:true }] },
      { label:'Colors', items:colors, key:'Color_ID', text:'Color', path:'colors', single:'color', rename:true,
        add:[{ name:'Color', label:'Color name', required:true }] },
      { label:'Sizes', items:sizes, key:'Size_ID', text:'Size', path:'sizes', single:'size', rename:true,
        add:[{ name:'Size', label:'Size name', required:true }] }
    ]; %>
    <div class="dashboard-grid" aria-label="Catalog records">
      <% groups.forEach(group => { %>
      <section class="panel">
        <div class="panel-bar"><strong><%= group.label %></strong> (<%= group.items.length %>)</div>
        <div class="table-scroll">
          <table class="data-table">
            <thead><tr><th scope="col">Record</th><th scope="col">Action</th></tr></thead>
            <tbody>
              <% if (!group.items.length) { %>
                <tr><td colspan="2" class="empty-cell">No records available</td></tr>
              <% } %>
              <% group.items.forEach(item => { %>
                <tr>
                  <% if (group.rename) { %>
                    <td colspan="2">
                      <form action="/manage/rename/<%= group.path %>/<%= item[group.key] %>" method="POST" style="display:flex;gap:.5rem;align-items:center;"
                            data-confirm="Rename <%= item[group.text] %>?" data-confirm-button="Save">
                        <label class="visually-hidden" for="rename-<%= group.path %>-<%= item[group.key] %>">Rename <%= item[group.text] %></label>
                        <input class="form-control" id="rename-<%= group.path %>-<%= item[group.key] %>" name="Name" value="<%= item[group.text] %>" maxlength="50" required>
                        <button type="submit" class="btn btn-outline-secondary">Save</button>
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      </form>
                    </td>
                  <% } else { %>
                    <td><%= item[group.text] || '#' + item[group.key] %></td>
                    <td><a href="/<%= group.path %>/<%= item[group.key] %>/edit">Edit</a></td>
                  <% } %>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% if (group.add) { %>
        <form action="/manage/add/<%= group.path %>" method="POST" style="padding:1rem;">
          <% group.add.forEach(f => { %>
            <label class="form-label" for="add-<%= group.path %>-<%= f.name %>"><%= f.label %></label>
            <input class="form-control mb-2" id="add-<%= group.path %>-<%= f.name %>" name="<%= f.name %>"
                   type="<%= f.type || 'text' %>" maxlength="100" <%= f.required ? 'required' : '' %>>
          <% }) %>
          <button type="submit" class="btn btn-primary">Add <%= group.single %></button>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        </form>
        <% } %>
      </section>
      <% }); %>
    </div>
    <%- include('../template/footer') %>
  </main>
</div>
<%- include('../template/scripts') %>
<%- include('../template/confirm') %>
</body>
</html>