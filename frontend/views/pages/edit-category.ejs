<!doctype html>
<html lang="en">
<head>
<%- include('../template/head', { title: 'Edit category' }); %>
</head>

<body>
<div class="app">
<%- include('../template/nav', { active: 'none' }); %>
<main class="content">
<%- include('../template/topbar'); %>
<header class="page-header">
<h1>Edit category #<%= category.Category_ID %></h1>
</header>
<section class="panel form-panel">

<form action="/categories/<%= category.Category_ID %>/edit" method="POST"
data-confirm="Save changes to <%= category.Category %>?"
data-confirm-button="Save changes">
<div class="mb-3">
<label for="Category" class="form-label">Category</label>
<input type="text" class="form-control" id="Category" name="Category"
value="<%= category.Category %>" required>
</div>

<button type="submit" class="btn btn-primary">Save changes</button>
<a href="/" class="btn btn-outline-secondary">Cancel</a>
</form>

<hr class="my-4">
<form action="/categories/<%= category.Category_ID %>/delete" method="POST"
data-confirm="Delete <%= category.Category %>? This can't be undone."
data-confirm-button="Delete">
<button type="submit" class="btn btn-outline-danger">Delete category</button>
</form>
</section>
<%- include('../template/footer'); %>
</main>
</div>
<%- include('../template/scripts'); %>
<%- include('../template/confirm'); %>
</body>
</html>