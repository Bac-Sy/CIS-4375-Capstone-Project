<%
  // Best sellers: products (or sizes and colors) ranked by units sold, with the first and last day each sold.
  const isCustom = typeof custom !== 'undefined' && custom;
  const rangeFrom = typeof from !== 'undefined' ? from : '';
  const rangeTo = typeof to !== 'undefined' ? to : '';
  const periodLabel = isCustom ? fmt.date(rangeFrom) + ' – ' + fmt.date(rangeTo) : ((periods.find(p => p.days === days) || {}).label || '');
  const periodQuery = isCustom ? 'from=' + rangeFrom + '&to=' + rangeTo : 'days=' + days;
  // each row links to the Sales report for that product over the same dates
  const salesLink = r => {
    const start = isCustom ? rangeFrom : (typeof salesFrom !== 'undefined' && salesFrom) ? salesFrom : (r.First_Sold || '');
    const end = isCustom ? rangeTo : (typeof salesTo !== 'undefined' ? salesTo : '');
    return '/reports/sales?from=' + start + '&to=' + end + '&product=' + r.Product_ID;
  };
%>
<!doctype html>
<html lang="en">
    <head>
        <%- include('../template/head', { title: 'Best sellers' }); %>
    </head>

    <body>
        <div class="app">
            <%- include('../template/nav', { active: 'reports' }); %>

            <main class="content">
                <%- include('../template/topbar'); %>
                <%- include('../template/messages'); %>

                <%- include('../template/reportbar', { reportKey: 'best', reportTitle: 'Best sellers',
                     reportSubtitle: periodLabel + (view === 'item' ? ' · by size and color' : ' · by product'),
                     exportHref: '/reports/best-sellers?' + periodQuery + '&view=' + view }); %>

                <!-- Filters for this report (the tabs above switch reports) -->
                <section class="filter-bar no-print" aria-label="Filter this report">
                  <div class="filter-group">
                    <span class="filter-label">Period</span>
                    <nav class="pills" aria-label="Report period">
                      <% periods.forEach(p => { %>
                        <a href="/reports/best-sellers?days=<%= p.days %>&view=<%= view %>" class="<%= !isCustom && days === p.days ? 'active' : '' %>"<% if (!isCustom && days === p.days) { %> aria-current="page"<% } %>><%= p.label %></a>
                      <% }) %>
                    </nav>
                    <form class="filter-dates" method="GET" action="/reports/best-sellers">
                      <input type="hidden" name="view" value="<%= view %>">
                      <label for="bsFrom">From</label>
                      <input type="date" id="bsFrom" name="from" class="form-control form-control-sm" value="<%= rangeFrom %>" required>
                      <label for="bsTo">To</label>
                      <input type="date" id="bsTo" name="to" class="form-control form-control-sm" value="<%= rangeTo %>" required>
                      <button type="submit" class="btn btn-sm <%= isCustom ? 'btn-primary' : 'btn-outline-secondary' %>">Show</button>
                    </form>
                  </div>
                  <div class="filter-group">
                    <span class="filter-label">Group by</span>
                    <nav class="pills" aria-label="Group by">
                      <a href="/reports/best-sellers?<%= periodQuery %>&view=product" class="<%= view === 'product' ? 'active' : '' %>"<% if (view === 'product') { %> aria-current="page"<% } %>>Product</a>
                      <a href="/reports/best-sellers?<%= periodQuery %>&view=item" class="<%= view === 'item' ? 'active' : '' %>"<% if (view === 'item') { %> aria-current="page"<% } %>>Size and color</a>
                    </nav>
                  </div>
                </section>

                <% const rows = view === 'item' ? byItem : byProduct; %>
                <% const cols = view === 'item' ? 9 : 8; %>
                <section class="panel">
                  <div class="panel-bar">
                    <%= fmt.number(totalUnits) %> <%= totalUnits === 1 ? 'unit' : 'units' %> sold, <%= fmt.money(totalRevenue) %> in sales
                  </div>
                  <div class="table-scroll">
                    <table class="data-table">
                      <caption class="visually-hidden">Products ranked by units sold</caption>
                      <thead>
                        <tr>
                          <th scope="col" class="num">Rank</th>
                          <th scope="col">Product</th>
                          <% if (view === 'item') { %>
                            <th scope="col">Size</th>
                            <th scope="col">Color</th>
                          <% } else { %>
                            <th scope="col">Category</th>
                          <% } %>
                          <th scope="col" class="num">Units sold</th>
                          <th scope="col" class="num">Total sales</th>
                          <th scope="col" class="num">Share of units sold</th>
                          <th scope="col">First sold</th>
                          <th scope="col">Last sold</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% if (!dataAvailable) { %>
                          <tr><td colspan="<%= cols %>" class="empty-cell">The report is unavailable. Check the message above.</td></tr>
                        <% } else if (!rows.length) { %>
                          <tr><td colspan="<%= cols %>" class="empty-cell">No products found.</td></tr>
                        <% } %>
                        <% rows.forEach(r => { %>
                          <tr>
                            <td class="num"><%= r.Units_Sold > 0 ? '#' + r.Rank : '–' %></td>
                            <td>
                              <% if (r.Units_Sold > 0 && r.Product_ID) { %>
                                <a class="row-link" href="<%= salesLink(r) %>" title="See each sale of <%= r.Product %>"><strong><%= r.Product %></strong></a>
                              <% } else { %><strong><%= r.Product %></strong><% } %>
                            </td>
                            <% if (view === 'item') { %>
                              <td><%= r.Size %></td>
                              <td><%= r.Color %></td>
                            <% } else { %>
                              <td><%= r.Category %></td>
                            <% } %>
                            <td class="num"><%= fmt.number(r.Units_Sold) %></td>
                            <td class="num"><%= fmt.money(r.Revenue) %></td>
                            <td class="num"><%= totalUnits > 0 ? Math.round(r.Units_Sold / totalUnits * 100) + '%' : '0%' %></td>
                            <td><%= r.First_Sold ? fmt.date(r.First_Sold) : '–' %></td>
                            <td><%= r.Last_Sold ? fmt.date(r.Last_Sold) : '–' %></td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                </section>
                <p class="empty report-note">Counts sales only (not restocks or adjustments). Total sales = units sold × each item's current price. First sold and last sold are the first and last day it sold in this period; click a product to see each of its sales. Items with no sales in this period are listed at the bottom, without a rank.</p>

                <%- include('../template/footer'); %>
            </main>
        </div>
        <%- include('../template/scripts'); %>
    </body>
</html>
