<!doctype html>
<html lang="en">
    <head>
        <%- include('../template/head', { title: 'Best sellers' }); %>
    </head>

    <body>
        <div class="app">
            <%- include('../template/nav', { active: 'reports' }); %>

            <main class="content">
                <%- include('../template/topbar'); %>
                <%- include('../template/messages'); %>

                <% const periodLabel = (periods.find(p => p.days === days) || {}).label || ''; %>
                <%- include('../template/reportbar', { reportKey: 'best', reportTitle: 'Best sellers',
                     reportSubtitle: periodLabel + (view === 'item' ? ' · by size and color' : ' · by product'),
                     exportHref: '/reports/best-sellers?days=' + days + '&view=' + view }); %>

                <!-- Time period. Keeps the current view (product or item) when switching. -->
                <nav class="tabs no-print" aria-label="Report period">
                  <% periods.forEach(p => { %>
                    <a href="/reports/best-sellers?days=<%= p.days %>&view=<%= view %>" class="<%= days === p.days ? 'active' : '' %>"<% if (days === p.days) { %> aria-current="page"<% } %>><%= p.label %></a>
                  <% }) %>
                </nav>

                <!-- By product adds all sizes and colors together. By item lists each size and color separately. -->
                <nav class="tabs no-print" aria-label="Group by">
                  <a href="/reports/best-sellers?days=<%= days %>&view=product" class="<%= view === 'product' ? 'active' : '' %>"<% if (view === 'product') { %> aria-current="page"<% } %>>By product</a>
                  <a href="/reports/best-sellers?days=<%= days %>&view=item" class="<%= view === 'item' ? 'active' : '' %>"<% if (view === 'item') { %> aria-current="page"<% } %>>By size and color</a>
                </nav>

                <% const rows = view === 'item' ? byItem : byProduct; %>
                <% const cols = view === 'item' ? 7 : 6; %>
                <section class="panel">
                  <div class="panel-bar">
                    <%= fmt.number(totalUnits) %> <%= totalUnits === 1 ? 'unit' : 'units' %> sold, <%= fmt.money(totalRevenue) %> in sales
                  </div>
                  <div class="table-scroll">
                    <table class="data-table">
                      <caption class="visually-hidden">Products ranked by units sold</caption>
                      <thead>
                        <tr>
                          <th scope="col" class="num">Rank</th>
                          <th scope="col">Product</th>
                          <% if (view === 'item') { %>
                            <th scope="col">Size</th>
                            <th scope="col">Color</th>
                          <% } else { %>
                            <th scope="col">Category</th>
                          <% } %>
                          <th scope="col" class="num">Units sold</th>
                          <th scope="col" class="num">Total sales</th>
                          <th scope="col" class="num">Share of units sold</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% if (!dataAvailable) { %>
                          <tr><td colspan="<%= cols %>" class="empty-cell">The report is unavailable. Check the message above.</td></tr>
                        <% } else if (!rows.length) { %>
                          <tr><td colspan="<%= cols %>" class="empty-cell">No products found.</td></tr>
                        <% } %>
                        <% rows.forEach(r => { %>
                          <tr>
                            <td class="num"><%= r.Units_Sold > 0 ? '#' + r.Rank : '–' %></td>
                            <td><strong><%= r.Product %></strong></td>
                            <% if (view === 'item') { %>
                              <td><%= r.Size %></td>
                              <td><%= r.Color %></td>
                            <% } else { %>
                              <td><%= r.Category %></td>
                            <% } %>
                            <td class="num"><%= fmt.number(r.Units_Sold) %></td>
                            <td class="num"><%= fmt.money(r.Revenue) %></td>
                            <td class="num"><%= totalUnits > 0 ? Math.round(r.Units_Sold / totalUnits * 100) + '%' : '0%' %></td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                </section>
                <p class="empty report-note">Counts sales only (not restocks or adjustments). Total sales = units sold × each item's current price. Items with no sales in this period are listed at the bottom, without a rank.</p>

                <%- include('../template/footer'); %>
            </main>
        </div>
        <%- include('../template/scripts'); %>
    </body>
</html>
