<!doctype html>
<html lang="en">
    <head>
        <%- include('../template/head', { title: 'Orders' }); %>
    </head>

    <body>
        <div class="app">
            <%- include('../template/nav', { active: 'orders' }); %>

            <main class="content">
                <%- include('../template/topbar'); %>
                <%- include('../template/messages'); %>

                <header class="page-header page-header-row">
                  <h1>Orders</h1>
                  <a href="/new/transaction" class="scc-btn">
                    + Record Transaction
                  </a>
                </header>

                <%
                  // search and filters (this page only); the search runs in the database query, so it covers every order
                  const oq = typeof q !== 'undefined' ? q : '', ofrom = typeof from !== 'undefined' ? from : '', oto = typeof to !== 'undefined' ? to : '';
                  const ordersHref = extra => {
                    const all = Object.assign({ type: selected, q: oq, from: ofrom, to: oto }, extra || {});
                    const s = Object.keys(all).filter(k => all[k]).map(k => k + '=' + encodeURIComponent(all[k])).join('&');
                    return '/orders' + (s ? '?' + s : '');
                  };
                  const ordersFiltered = Boolean(oq || ofrom || oto);
                %>
                <!-- Search and filters for this page only -->
                <form class="filter-bar" method="GET" action="/orders" role="search" aria-label="Search and filter orders">
                  <div class="filter-group">
                    <span class="filter-label">Type</span>
                    <nav class="pills" aria-label="Filter orders by type">
                      <a href="<%= ordersHref({ type: '' }) %>" class="<%= selected ? '' : 'active' %>"<% if (!selected) { %> aria-current="true"<% } %>>All</a>
                      <% types.forEach(t => { %>
                        <a href="<%= ordersHref({ type: t }) %>" class="<%= selected === t ? 'active' : '' %>"<% if (selected === t) { %> aria-current="true"<% } %>><%= t %></a>
                      <% }) %>
                    </nav>
                  </div>
                  <div class="filter-group filter-dates">
                    <% if (selected) { %><input type="hidden" name="type" value="<%= selected %>"><% } %>
                    <%- include('../template/searchbox', { searchValue: oq, searchLabel: 'Search orders', searchPlaceholder: 'Order #, product, color, employee…', clearHref: ordersHref({ q: '' }) }) %>
                    <label for="from">From</label>
                    <input type="date" id="from" name="from" class="form-control form-control-sm" value="<%= ofrom %>">
                    <label for="to">To</label>
                    <input type="date" id="to" name="to" class="form-control form-control-sm" value="<%= oto %>">
                    <button type="submit" class="btn btn-sm btn-primary">Search</button>
                    <% if (ordersFiltered || selected) { %><a href="/orders" class="filter-clear">Clear filters</a><% } %>
                  </div>
                </form>

                <section class="panel">
                  <div class="panel-bar">
                    <% const pg = typeof pageNumber !== 'undefined' ? pageNumber : 1; const more = typeof hasMore !== 'undefined' && hasMore;
                       const first = (pg - 1) * limit + 1; const pageLink = n => ordersHref({ page: n > 1 ? n : '' }); %>
                    <% if (pg === 1 && !more) { %><%= fmt.number(rows.length) %> <%= rows.length === 1 ? 'record' : 'records' %><% } else { %>Showing <%= fmt.number(first) %>–<%= fmt.number(first + rows.length - 1) %>, newest first<% } %><% if (oq) { %> matching “<%= oq %>”<% } %><% if (ofrom || oto) { %> · <%= ofrom ? fmt.date(ofrom) : '…' %> – <%= oto ? fmt.date(oto) : 'today' %><% } %>
                  </div>
                  <div class="table-scroll">
                    <table class="data-table">
                      <caption class="visually-hidden">Order and transaction records</caption>
                      <thead>
                        <tr>
                          <th scope="col">Order #</th>
                          <th scope="col">Date</th>
                          <th scope="col">Type</th>
                          <th scope="col">Product</th>
                          <th scope="col">Size</th>
                          <th scope="col">Color</th>
                          <th scope="col" class="num">Qty change</th>
                          <th scope="col">Employee</th>
                          <th scope="col" class="menu-cell"><span class="visually-hidden">Actions</span></th>
                        </tr>
                      </thead>
                      <tbody>
                        <% if (!dataAvailable) { %>
                          <tr><td colspan="9" class="empty-cell">Order data is unavailable. Check the message above and the Flask database mapping.</td></tr>
                        <% } else if (!rows.length) { %>
                          <tr><td colspan="9" class="empty-cell"><% if (ordersFiltered || selected) { %>No orders match these filters. <a href="/orders">Clear filters</a><% } else { %>No orders yet.<% } %></td></tr>
                        <% } %>
                        <% const newOrderIds = new Set((typeof newOrders !== 'undefined' && Array.isArray(newOrders) ? newOrders : []).map(String)); %>
                        <% rows.forEach(r => { %>
                          <% const orderIsNew = newOrderIds.has(String(r.invoice_id)); %>
                          <tr id="o<%= r.invoice_id %>" class="<%= orderIsNew ? 'just-added' : '' %>">
                            <td><strong><%= r.invoice_id == null ? 'N/A' : '#' + r.invoice_id %></strong><% if (orderIsNew) { %> <span class="tag tag-new">New</span><% } %></td>
                            <td><%= fmt.date(r.date) %></td>
                            <td><span class="tag tag-<%= String(r.transaction_type).toLowerCase() %>"><%= r.transaction_type %></span><% if (r.transaction_type === 'Restock' && r.supplier) { %><span class="from-supplier">from <%= r.supplier %></span><% } %></td>
                            <td><strong><%= r.product %></strong></td>
                            <td><%= r.size %></td>
                            <td><%= r.color %></td>
                            <td class="num"><span class="qty <%= r.quantity_change < 0 ? 'neg' : 'pos' %>"><%= fmt.signed(r.quantity_change) %></span></td>
                            <td><%= r.employee || 'N/A' %></td>
                            <td class="menu-cell">
                              <%- include('../template/rowmenu', { menuLabel: 'Actions for order #' + r.invoice_id, menuItems: (r.invoice_id && authenticated) ? [
                                { label: 'Edit order', href: '/orders/' + r.invoice_id + '/edit', icon: 'edit' },
                                Role === 'Manager' && { label: 'Delete order', action: '/orders/' + r.invoice_id + '/delete', icon: 'delete', danger: true,
                                  confirm: 'Delete order #' + r.invoice_id + ' (' + r.transaction_type + ', ' + r.product + ' ' + r.size + ' / ' + r.color + ')? This reverses its stock change.',
                                  confirmButton: 'Delete order' }
                              ] : [] }) %>
                            </td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                  <% if (pg > 1 || more) { %>
                    <nav class="pager" aria-label="More orders">
                      <% if (pg > 1) { %><a class="btn btn-outline-secondary" href="<%= pageLink(pg - 1) %>">← Newer orders</a><% } else { %><span></span><% } %>
                      <% if (more) { %><a class="btn btn-outline-secondary" href="<%= pageLink(pg + 1) %>">Older orders →</a><% } %>
                    </nav>
                  <% } %>
                </section>

                <%- include('../template/footer'); %>
            </main>
        </div>
        <%- include('../template/scripts'); %>
        <%- include('../template/confirm'); %>
      </body>
    </html>
