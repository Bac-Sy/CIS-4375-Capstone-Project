<%
  const navItems = [
    { key: 'dashboard', label: 'Dashboard', href: '/',
      icon: '<rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/>' },
    { key: 'inventory', label: 'Inventory', href: '/inventory',
      icon: '<path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3.3 7.5L12 12.5l8.7-5M12 22V12.5"/>' },
    { key: 'orders', label: 'Orders', href: '/orders',
      icon: '<path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 12h6M9 16h4"/>' },
    { key: 'employees', label: 'Employees', href: '/employees',
      icon: '<path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/><circle cx="10" cy="7" r="4"/><path d="M21 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>' },
    { key: 'settings', label: 'Settings', href: '/settings',
      icon: '<path d="M4 6h8.5M17.5 6H20M4 12h2.5M11.5 12H20M4 18h10.5M19.5 18H20"/><circle cx="15" cy="6" r="2.5"/><circle cx="9" cy="12" r="2.5"/><circle cx="17" cy="18" r="2.5"/>' }
  ];
%>
<aside class="sidebar" id="sidebar" aria-label="Site navigation">
  <button type="button" class="menu-btn drawer-close" data-menu-toggle aria-label="Close menu" aria-expanded="false" aria-controls="sidebar">
    <span></span><span></span>
  </button>

  <div class="sidebar-top">
    <img class="logo" src="/images/logo.png" alt="SCC logo">
    <nav class="site-nav" aria-label="Main">
      <% navItems.forEach(item => { %>
        <a href="<%= item.href %>"
           class="<%= active === item.key ? 'active' : '' %>"
           <% if (active === item.key) { %>aria-current="page"<% } %>>
          <svg viewBox="0 0 24 24" aria-hidden="true"><%- item.icon %></svg>
          <span><%= item.label %></span>
        </a>
      <% }) %>
    </nav>
  </div>

  <div class="sidebar-user">
    <span class="user-avatar" aria-hidden="true"><%= String(user.name).charAt(0).toUpperCase() %></span>
    <div class="user-meta">
      <div class="user-name"><%= user.name %></div>
      <div class="user-username"><%= user.username %></div>
    </div>
    <% if (authenticated) { %>
      <form action="/logout" method="POST" class="logout-form">
        <button type="submit" class="logout" aria-label="Log out" title="Log out">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
            <path d="M16 17l5-5-5-5M21 12H9"/>
          </svg>
        </button>
      </form>
    <% } else { %>
      <a href="/login" class="logout" aria-label="Log in" title="Log in">
        <svg viewBox="0 0 24 24" aria-hidden="true" style="width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round">
          <path d="M10 17l5-5-5-5M15 12H3"/>
          <path d="M12 3h7a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-7"/>
        </svg>
      </a>
    <% } %>
  </div>
</aside>
