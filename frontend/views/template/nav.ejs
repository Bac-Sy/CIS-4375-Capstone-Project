<%
  // Sidebar navigation (Madison's design). Uses the login info server.js puts on every page:
  // FirstName and Role come from the session. Pages can pass { active: 'inventory' } to highlight a link.
  const signedIn = typeof FirstName !== 'undefined' && FirstName;
  const userRole = typeof Role !== 'undefined' && Role ? Role : '';
  const current = typeof active !== 'undefined' ? active : '';

  const navItems = [
    { key: 'dashboard', label: 'Dashboard', href: '/', show: true,
      icon: '<rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/>' },
    { key: 'inventory', label: 'Inventory', href: '/inventory', show: signedIn,
      icon: '<path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3.3 7.5L12 12.5l8.7-5M12 22V12.5"/>' },
    { key: 'orders', label: 'Orders', href: '/orders', show: signedIn,
      icon: '<path d="M8 3h10l3 3v15H8z"/><path d="M11 10h7M11 14h7M11 18h5"/>' },
    { key: 'employees', label: 'Employees', href: '/employees', show: signedIn,
      icon: '<circle cx="9" cy="8" r="3"/><path d="M3 20v-2a6 6 0 0 1 12 0v2M17 8a3 3 0 0 1 0 6M17 17a4 4 0 0 1 4 3"/>' },
    { key: 'settings', label: 'Settings', href: '/settings', show: signedIn,
      icon: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M5 19l2-2M17 7l2-2"/>' },
    { key: 'manage', label: 'Manage catalog', href: '/manage', show: signedIn && userRole === 'Manager',
      icon: '<path d="M3 5h18v14H3zM3 10h18M9 10v9"/>' },
    { key: 'newemployee', label: 'Add employee', href: '/new/employee', show: signedIn && userRole === 'Manager',
      icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/>' }
  ];
%>
<aside class="sidebar" id="sidebar" aria-label="Site navigation">
  <button type="button" class="menu-btn drawer-close" data-menu-toggle aria-label="Close menu" aria-expanded="false" aria-controls="sidebar">
    <span></span><span></span>
  </button>

  <div class="sidebar-top">
    <img class="logo" src="/images/logo.png" alt="SCC logo">
    <nav class="site-nav" aria-label="Main">
      <% navItems.filter(item => item.show).forEach(item => { %>
        <a href="<%= item.href %>"
           class="<%= current === item.key ? 'active' : '' %>"
           <% if (current === item.key) { %>aria-current="page"<% } %>>
          <svg viewBox="0 0 24 24" aria-hidden="true"><%- item.icon %></svg>
          <span><%= item.label %></span>
        </a>
      <% }) %>
    </nav>
  </div>

  <div class="sidebar-user">
    <span class="user-avatar" aria-hidden="true"><%= signedIn ? String(FirstName).charAt(0).toUpperCase() : 'G' %></span>
    <div class="user-meta">
      <div class="user-name"><%= signedIn ? FirstName : 'Guest' %></div>
      <div class="user-username"><%= signedIn ? userRole : 'Not logged in' %></div>
    </div>
    <% if (signedIn) { %>
      <form action="/logout" method="POST" class="logout-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="logout" aria-label="Log out" title="Log out">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
            <path d="M16 17l5-5-5-5M21 12H9"/>
          </svg>
        </button>
      </form>
    <% } else { %>
      <a href="/login" class="logout" aria-label="Log in" title="Log in">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M10 17l5-5-5-5M15 12H3"/>
          <path d="M12 3h7a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-7"/>
        </svg>
      </a>
    <% } %>
  </div>
</aside>
