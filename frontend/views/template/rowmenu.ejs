<%
  // The ⋯ menu at the end of a table row. Include it with:
  //   include('../template/rowmenu', { menuLabel: 'Actions for Satin Midi Dress', menuItems: [
  //     { label: 'Edit product', href: '/products/1/edit', icon: 'edit' },
  //     { label: 'Delete', action: '/products/1/delete', confirm: 'Delete Satin Midi Dress?', confirmButton: 'Delete', danger: true }
  //   ] })
  // An item with href is a link. An item with action is a POST form (with the CSRF token) that asks
  // data-confirm before sending. Items set to null or false are skipped, so roles can hide them.
  const rowMenuItems = (typeof menuItems !== 'undefined' && Array.isArray(menuItems)) ? menuItems.filter(Boolean) : [];
  const rowMenuLabel = typeof menuLabel !== 'undefined' ? menuLabel : 'Actions';
  const rowMenuIcons = {
    edit: '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/>',
    add: '<path d="M12 5v14M5 12h14"/>',
    adjust: '<path d="M7 15l5 5 5-5"/><path d="M7 9l5-5 5 5"/>',
    delete: '<path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/>',
    key: '<circle cx="8" cy="15" r="4"/><path d="M11 12l9-9M17 6l3 3M14 9l2 2"/>',
    box: '<path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/>'
  };
%>
<% if (rowMenuItems.length) { %>
<details class="row-menu">
  <summary class="row-menu-btn" aria-label="<%= rowMenuLabel %>" title="<%= rowMenuLabel %>">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></svg>
  </summary>
  <div class="row-menu-list">
    <% rowMenuItems.forEach(function(item) { %>
      <% const icon = rowMenuIcons[item.icon] || ''; %>
      <% if (item.action) { %>
        <form action="<%= item.action %>" method="POST" class="row-menu-form"
              <% if (item.confirm) { %>data-confirm="<%= item.confirm %>" data-confirm-button="<%= item.confirmButton || 'Confirm' %>"<% } %>
              <% if (item.danger) { %>data-confirm-style="danger"<% } %>>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="row-menu-item<%= item.danger ? ' danger' : '' %>">
            <% if (icon) { %><svg viewBox="0 0 24 24" aria-hidden="true"><%- icon %></svg><% } %><span><%= item.label %></span>
          </button>
        </form>
      <% } else { %>
        <a href="<%= item.href %>" class="row-menu-item<%= item.danger ? ' danger' : '' %>">
          <% if (icon) { %><svg viewBox="0 0 24 24" aria-hidden="true"><%- icon %></svg><% } %><span><%= item.label %></span>
        </a>
      <% } %>
    <% }); %>
  </div>
</details>
<% } %>
