<%
  // Search box for one page (it only searches that page). Put it inside the page's GET filter form.
  // include('../template/searchbox', { searchValue: q, searchLabel: 'Search orders', searchPlaceholder: '…', clearHref: '/orders' })
  const sbValue = typeof searchValue !== 'undefined' && searchValue ? searchValue : '';
  const sbLabel = typeof searchLabel !== 'undefined' ? searchLabel : 'Search';
  const sbPlaceholder = typeof searchPlaceholder !== 'undefined' ? searchPlaceholder : 'Search';
  const sbClear = typeof clearHref !== 'undefined' ? clearHref : '';
  const sbId = typeof searchId !== 'undefined' ? searchId : 'q';
%>
<div class="search-box">
  <svg class="search-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-3.5-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  <label for="<%= sbId %>" class="visually-hidden"><%= sbLabel %></label>
  <input type="search" id="<%= sbId %>" name="q" class="form-control form-control-sm" value="<%= sbValue %>"
         placeholder="<%= sbPlaceholder %>" maxlength="100" autocomplete="off" enterkeyhint="search">
  <% if (sbValue && sbClear) { %><a class="search-clear" href="<%= sbClear %>" aria-label="Clear the search">✕</a><% } %>
</div>
