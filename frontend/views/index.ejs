
<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../template/head', { title: 'Dashboard' }); %>
</head>

<body>
    <div class="app">
        <%- include('../template/nav', { active: 'dashboard' }); %>

        <main class="content">
            <%- include('../template/topbar'); %>
            <%- include('../template/messages'); %>

            <%
                const sales = data && data.sales ? data.sales : {
                    revenue: 0,
                    units: 0,
                    days: 30
                };

                const recentOrders = data && Array.isArray(data.recent_orders)
                    ? data.recent_orders : [];

                const lowStock = data && Array.isArray(data.low_stock)
                    ? data.low_stock : [];

                const threshold = data && data.low_stock_threshold
                    ? data.low_stock_threshold : 5;

                const hasDonut = donut && Array.isArray(donut.segments)
                    && donut.segments.length > 0;

                const hasTrend = trend && trend.first && trend.last;
            %>

            <header class="page-header">
                <h1>Welcome, <%= user && user.firstName ? user.firstName : 'User' %></h1>
            </header>

            <section class="dashboard-grid" aria-label="Dashboard overview">

                <!-- SALES -->
                <article class="dash-card">
                    <h2>Sales</h2>

                    <div class="dash-body sales">
                        <% if (hasDonut) { %>

                            <svg class="donut"
                                 viewBox="0 0 42 42"
                                 role="img"
                                 aria-label="Sales by category for the last <%= sales.days %> days">

                                <circle
                                    cx="21"
                                    cy="21"
                                    r="15.9155"
                                    fill="none"
                                    stroke="#e4e7ff"
                                    stroke-width="7"
                                />

                                <% donut.segments.forEach(function(seg) { %>
                                    <circle
                                        cx="21"
                                        cy="21"
                                        r="15.9155"
                                        fill="none"
                                        stroke="<%= seg.color %>"
                                        stroke-width="7"
                                        stroke-dasharray="<%= seg.dash %>"
                                        stroke-dashoffset="<%= seg.offset %>"
                                    />
                                <% }); %>

                            </svg>

                            <div class="sales-summary">
                                <p class="sales-total">
                                    <%= fmt.money(sales.revenue) %>
                                </p>

                                <p class="sales-note">
                                    <%= fmt.number(sales.units) %> units sold in the last
                                    <%= sales.days %> days
                                </p>

                                <ul class="legend">
                                    <% donut.segments.forEach(function(seg) { %>
                                        <li>
                                            <span
                                                class="dot"
                                                style="background-color: <%= seg.color %>">
                                            </span>

                                            <span class="legend-name">
                                                <%= seg.name %>
                                            </span>

                                            <span class="legend-value">
                                                <%= fmt.money(seg.revenue) %>
                                            </span>
                                        </li>
                                    <% }); %>
                                </ul>
                            </div>

                        <% } else { %>

                            <p class="empty">
                                No sales in the last <%= sales.days %> days.
                            </p>

                        <% } %>
                    </div>
                </article>

                <!-- RECENT ORDERS -->
                <article class="dash-card">
                    <h2>Recent Orders</h2>

                    <div class="dash-body">
                        <% if (recentOrders.length > 0) { %>

                            <ul class="rows">
                                <% recentOrders.forEach(function(o) { %>
                                    <li>
                                        <div class="row-main">
                                            <span class="row-title">
                                                <%= o.product || 'Unknown Product' %>
                                            </span>

                                            <span class="row-sub">
                                                <%= o.size || 'N/A' %> /
                                                <%= o.color || 'N/A' %>,
                                                <%= o.date ? fmt.date(o.date) : 'N/A' %>,
                                                <%= o.employee || 'Unknown' %>
                                            </span>
                                        </div>

                                        <div class="row-side">
                                            <span class="tag <%= fmt.tagClass(o.transaction_type) %>">
                                                <%= o.transaction_type || 'Unknown' %>
                                            </span>

                                            <span class="qty <%= Number(o.quantity_change) < 0 ? 'neg' : 'pos' %>">
                                                <%= fmt.signed(o.quantity_change || 0) %>
                                            </span>
                                        </div>
                                    </li>
                                <% }); %>
                            </ul>

                        <% } else { %>

                            <p class="empty">
                                No orders recorded yet.
                            </p>

                        <% } %>
                    </div>
                </article>

                <!-- LOW STOCK -->
                <article class="dash-card">
                    <h2>Low Stock</h2>

                    <div class="dash-body">
                        <% if (lowStock.length > 0) { %>

                            <ul class="rows">
                                <% lowStock.forEach(function(item) {
                                    const quantity = Number(item.quantity) || 0;
                                    const pct = threshold > 0
                                        ? Math.min(100, Math.max(0, Math.round((quantity / threshold) * 100)))
                                        : 0;
                                %>

                                    <li class="stock-row">
                                        <div class="row-main">
                                            <span class="row-title">
                                                <%= item.product || 'Unknown Product' %>
                                            </span>

                                            <span class="row-sub">
                                                <%= item.size || 'N/A' %> /
                                                <%= item.color || 'N/A' %>
                                            </span>
                                        </div>

                                        <span
                                            class="meter"
                                            role="img"
                                            aria-label="<%= quantity %> in stock">

                                            <i style="width: <%= pct %>%;"></i>
                                        </span>

                                        <span class="tag tag-red">
                                            <%= quantity %> left
                                        </span>
                                    </li>

                                <% }); %>
                            </ul>

                        <% } else { %>

                            <p class="empty">
                                Nothing is running low. Items with
                                <%= threshold %> or fewer units appear here.
                            </p>

                        <% } %>
                    </div>
                </article>

                <!-- INVENTORY TREND -->
                <article class="dash-card">
                    <h2>Inventory Trend Graph</h2>

                    <div class="dash-body">
                        <% if (hasTrend) { %>

                            <div class="trend-wrap">

                                <p class="trend-total">
                                    <strong>
                                        <%= fmt.number(trend.last.total_units) %>
                                    </strong>
                                    units in stock on
                                    <%= fmt.date(trend.last.date) %>
                                </p>

                                <svg
                                    class="trend"
                                    viewBox="0 0 320 140"
                                    role="img"
                                    aria-label="Total units in stock from <%= fmt.date(trend.first.date) %> to <%= fmt.date(trend.last.date) %>">

                                    <defs>
                                        <linearGradient
                                            id="trendFill"
                                            x1="0"
                                            y1="0"
                                            x2="0"
                                            y2="1">

                                            <stop
                                                offset="0"
                                                style="stop-color:#0000aa;stop-opacity:.22"
                                            />

                                            <stop
                                                offset="1"
                                                style="stop-color:#0000aa;stop-opacity:0"
                                            />
                                        </linearGradient>
                                    </defs>

                                    <line
                                        class="grid-line"
                                        x1="0"
                                        y1="20"
                                        x2="320"
                                        y2="20"
                                    />

                                    <line
                                        class="grid-line"
                                        x1="0"
                                        y1="55"
                                        x2="320"
                                        y2="55"
                                    />

                                    <line
                                        class="grid-line"
                                        x1="0"
                                        y1="90"
                                        x2="320"
                                        y2="90"
                                    />

                                    <line
                                        class="grid-line"
                                        x1="0"
                                        y1="125"
                                        x2="320"
                                        y2="125"
                                    />

                                    <path
                                        class="trend-area"
                                        d="<%= trend.area || '' %>"
                                    />

                                    <path
                                        class="trend-line"
                                        d="<%= trend.line || '' %>"
                                    />

                                </svg>

                                <p class="trend-caption">
                                    <span>
                                        <%= fmt.date(trend.first.date) %>
                                    </span>

                                    <span>
                                        <%= fmt.date(trend.last.date) %>
                                    </span>
                                </p>

                            </div>

                        <% } else { %>

                            <p class="empty">
                                The graph appears once stock changes are
                                recorded on at least two different days.
                            </p>

                        <% } %>
                    </div>
                </article>

            </section>

            <%- include('../template/footer', { showStatus: true }); %>

        </main>
    </div>

    <%- include('../template/scripts'); %>
</body>
</html>
